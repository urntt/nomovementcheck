{
	"schemaVersion": 1,
	"id": "nomovementcheck",
	"version": "${version}",
	"name": "nomovementcheck",
	"description": "Makes the server completely trust selected players' clients on movement and position.",
	"authors": [
		"urntt"
	],
	"contact": {
		"homepage": "https://github.com/urntt/nomovementcheck",
		"sources": "https://github.com/urntt/nomovementcheck",
		"issues": "https://github.com/urntt/nomovementcheck/issues"
	},
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.urntt.nomovementcheck.NoMovementCheck"
		],
		"client": [
			"com.urntt.nomovementcheck.client.NoMovementCheckClient"
		]
	},
	"mixins": [
		"nomovementcheck.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=${java_version}",
		"fabric-api": ">=${fabric_api_version}"
	}
}
